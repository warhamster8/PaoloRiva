---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import BioColumn from "../components/BioColumn.astro";
import BooksColumn from "../components/BooksColumn.astro";
import { site } from "../data/site";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

function formatDate(date: Date) {
  return date.toLocaleDateString("it-IT", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}
---

<BaseLayout description={site.bio.short}>
  <div class="site-shell">
    <header class="site-header">
      <div class="site-header__media" aria-hidden="true">
        <img
          src="/images/header-hero.png?v=4"
          alt=""
          width="1920"
          height="1080"
          decoding="async"
          fetchpriority="high"
        />
      </div>
      <div class="site-header__veil" aria-hidden="true"></div>
      <div class="site-header__inner">
        <a class="brand" href="/">{site.name}</a>
        <div class="brand-meta">Scrittore · {site.location}</div>
      </div>
    </header>

    <div class="triptych">
      <BioColumn />

      <main class="column column-center">
        <div class="blog-head">
          <div class="kicker">Taccuino</div>
          <h1>Dal blog</h1>
          <p>
            Appunti, dietro le quinte e pezzi che nascono quando mi passa per la
            testa.
          </p>
        </div>

        {
          posts.length === 0 ? (
            <p class="empty-blog">Il taccuino è ancora vuoto. Torna presto.</p>
          ) : (
            <div class="post-list">
              {posts.map((post) => (
                <a class="post-item" href={`/blog/${post.id}/`}>
                  <div class="post-meta">
                    <time datetime={post.data.pubDate.toISOString()}>
                      {formatDate(post.data.pubDate)}
                    </time>
                    {post.data.tags.slice(0, 2).map((tag) => (
                      <span>{tag}</span>
                    ))}
                  </div>
                  <h2 class="post-title">{post.data.title}</h2>
                  <p class="post-excerpt">{post.data.description}</p>
                </a>
              ))}
            </div>
          )
        }
      </main>

      <BooksColumn />
    </div>

    <footer class="site-footer">
      <div>© {new Date().getFullYear()} {site.name}</div>
      <div>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </footer>
  </div>
</BaseLayout>
