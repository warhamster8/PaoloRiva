---
import BaseLayout from "../layouts/BaseLayout.astro";
import BioColumn from "../components/BioColumn.astro";
import BooksHero from "../components/BooksHero.astro";
import { site } from "../data/site";
---

<BaseLayout description={site.bio.short}>
  <div class="site-shell">
    <header class="site-header">
      <div class="site-header__media" aria-hidden="true">
        <img
          src="/images/header-hero.png?v=4"
          alt=""
          width="1920"
          height="1080"
          decoding="async"
          fetchpriority="high"
        />
      </div>
      <div class="site-header__veil" aria-hidden="true"></div>
      <div class="site-header__inner">
        <a class="brand" href="/">{site.name}</a>
        <div class="brand-meta">Scrittore · {site.location}</div>
      </div>
    </header>

    <div class="diptych">
      <BioColumn />
      <BooksHero />
    </div>

    <footer class="site-footer">
      <div>© {new Date().getFullYear()} {site.name}</div>
      <div>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </footer>
  </div>
</BaseLayout>
