---
import { site } from "../data/site";

const icons: Record<string, string> = {
  Instagram:
    '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7.5 3h9A4.5 4.5 0 0 1 21 7.5v9A4.5 4.5 0 0 1 16.5 21h-9A4.5 4.5 0 0 1 3 16.5v-9A4.5 4.5 0 0 1 7.5 3zm0 1.7A2.8 2.8 0 0 0 4.7 7.5v9A2.8 2.8 0 0 0 7.5 19.3h9a2.8 2.8 0 0 0 2.8-2.8v-9a2.8 2.8 0 0 0-2.8-2.8h-9zm9.15 1.35a1.05 1.05 0 1 1 0 2.1 1.05 1.05 0 0 1 0-2.1zM12 8.1A3.9 3.9 0 1 1 12 15.9 3.9 3.9 0 0 1 12 8.1zm0 1.7a2.2 2.2 0 1 0 0 4.4 2.2 2.2 0 0 0 0-4.4z"/></svg>',
  Facebook:
    '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14.5 8.5V6.8c0-.7.1-1.1 1.2-1.1H17V3h-2.4C11.8 3 11 4.5 11 6.6v1.9H9v2.7h2V21h3.5v-9.8h2.3l.4-2.7h-2.7z"/></svg>',
  Wattpad:
    '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.2 6.2c.7 0 1.3.3 1.7.9l2.4 3.8c.2.3.4.3.6 0l2.1-3.5c.5-.8 1.1-1.2 2-1.2.9 0 1.5.5 1.5 1.3 0 .3-.1.6-.2.9l-2.8 5.1c-.5.9-1.1 1.3-2 1.3-.8 0-1.5-.4-1.9-1.2L6.2 9.8c-.1-.2-.2-.2-.3 0L4.4 13c-.3.6-.5.9-.9 1.1-.3.2-.6.2-.9.2C1.6 14.3 1 13.7 1 12.7c0-.4.1-.8.3-1.2L3 7.4c.3-.8.8-1.2 1.2-1.2zm11.3 0c.8 0 1.4.4 1.8 1.1l2.5 4.3c.1.2.2.2.3 0l1.2-2.1c.3-.5.5-.8.9-1 .3-.2.6-.3.9-.3.9 0 1.5.6 1.5 1.5 0 .4-.1.8-.3 1.2l-2.2 4.3c-.5.9-1.1 1.3-2 1.3-.8 0-1.4-.4-1.8-1.2l-2.5-4.3c-.1-.2-.2-.2-.3 0l-1.1 1.9c-.3.5-.5.8-.9 1-.3.2-.6.3-1 .3-.8 0-1.4-.6-1.4-1.5 0-.4.1-.8.3-1.2l2-3.9c.5-.9 1.1-1.4 2.1-1.4z"/></svg>',
};

const classMap: Record<string, string> = {
  Instagram: "social--instagram",
  Facebook: "social--facebook",
  Wattpad: "social--wattpad",
};
---

<div class="socials" aria-label="Social">
  {
    site.socials.map((s) => (
      <a
        class:list={["social", classMap[s.label]]}
        href={s.href}
        target="_blank"
        rel="noopener"
        aria-label={s.label}
        title={s.label}
        set:html={icons[s.label] ?? s.label.slice(0, 1)}
      />
    ))
  }
</div>
