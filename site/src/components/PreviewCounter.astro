---
/**
 * Contatore sociale (deterministico): parte da 10 e cresce di +1
 * a intervalli irregolari, uguale per tutti i visitatori.
 */
const START = 10;
const CAP = 30;
const EPOCH = Date.parse("2026-09-11T10:00:00+02:00");
const SEED = 0xa5c01d;
const MIN_HOURS = 14;
const MAX_HOURS = 86;

function mulberry32(seed: number) {
  return () => {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

function previewCountAt(now: number): number {
  if (now < EPOCH) return START;
  const rand = mulberry32(SEED);
  let count = START;
  let t = EPOCH;
  while (count < CAP) {
    const hours = MIN_HOURS + rand() * (MAX_HOURS - MIN_HOURS);
    t += hours * 3_600_000;
    if (t > now) break;
    count += 1;
  }
  return count;
}

const initial = previewCountAt(Date.now());
---

<p
  class="preview-count"
  data-preview-counter
  data-start={START}
  data-cap={CAP}
  data-epoch={EPOCH}
  data-seed={SEED}
  data-min-hours={MIN_HOURS}
  data-max-hours={MAX_HOURS}
  aria-live="polite"
>
  <span class="preview-count__value" data-preview-value>{initial}</span>
  <span class="preview-count__label">persone hanno già ricevuto l’anteprima</span>
</p>

<script>
  function mulberry32(seed: number) {
    return () => {
      seed |= 0;
      seed = (seed + 0x6d2b79f5) | 0;
      let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }

  function countAt(
    now: number,
    start: number,
    cap: number,
    epoch: number,
    seed: number,
    minHours: number,
    maxHours: number,
  ) {
    if (now < epoch) return start;
    const rand = mulberry32(seed);
    let count = start;
    let t = epoch;
    while (count < cap) {
      const hours = minHours + rand() * (maxHours - minHours);
      t += hours * 3_600_000;
      if (t > now) break;
      count += 1;
    }
    return count;
  }

  function refresh() {
    document.querySelectorAll<HTMLElement>("[data-preview-counter]").forEach((el) => {
      const valueEl = el.querySelector<HTMLElement>("[data-preview-value]");
      if (!valueEl) return;
      const start = Number(el.dataset.start);
      const cap = Number(el.dataset.cap);
      const epoch = Number(el.dataset.epoch);
      const seed = Number(el.dataset.seed);
      const minHours = Number(el.dataset.minHours);
      const maxHours = Number(el.dataset.maxHours);
      valueEl.textContent = String(
        countAt(Date.now(), start, cap, epoch, seed, minHours, maxHours),
      );
    });
  }

  refresh();
  // Ricalcola ogni ora: cattura l’incremento senza polling aggressivo
  window.setInterval(refresh, 60 * 60 * 1000);
</script>
